<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>2D网格变形 - 拖动变形 + Ruppert 三角化</title>
  <script src="https://cdn.jsdelivr.net/npm/three@v0.117.0"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@v0.117.0/examples/js/loaders/OBJLoader.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      background: #060b14;
      color: #c6d1f4;
      font-family: 'Segoe UI', system-ui, sans-serif;
      overflow: hidden;
      height: 100vh;
    }
    .app {
      display: flex;
      flex-direction: column;
      height: 100vh;
    }
    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 10px 16px;
      background: #0a1020;
      border-bottom: 1px solid rgba(106,132,255,0.15);
      flex-shrink: 0;
      flex-wrap: wrap;
    }
    .toolbar label { font-size: 13px; color: #8a9dd4; }
    .toolbar select {
      padding: 6px 12px;
      border-radius: 8px;
      border: 1px solid rgba(106,132,255,0.3);
      background: #0d1528;
      color: #eef2ff;
      font-size: 14px;
      cursor: pointer;
    }
    .toolbar button {
      padding: 7px 16px;
      border-radius: 8px;
      border: 1px solid rgba(106,132,255,0.3);
      background: #111b31;
      color: #c6d1f4;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .toolbar button:hover:not(:disabled) {
      background: #1a2848;
      border-color: rgba(106,132,255,0.6);
    }
    .toolbar button:disabled { opacity: 0.4; cursor: not-allowed; }
    .toolbar button.primary {
      background: linear-gradient(135deg, #ff6b35 0%, #ff8f5e 100%);
      color: #fff;
      border: none;
      
    box-shadow: 0 3px 10px rgba(255,107,53,0.3); }
    .toolbar button.primary:hover:not(:disabled) {
      transform: translateY(-1px);
      box-shadow: 0 5px 15px rgba(255,107,53,0.5);
    }
    .toolbar .spacer { flex: 1; }
    .status {
      font-size: 12px;
      color: #5a6791;
      max-width: 360px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr;
      flex: 1;
      min-height: 0;
    }
    .panel {
      position: relative;
      border: 1px solid rgba(106,132,255,0.1);
      overflow: hidden;
    }
    .panel canvas {
      display: block;
      width: 100%;
      height: 100%;
    }
    .panel-label {
      position: absolute;
      top: 10px; left: 12px;
      font-size: 12px;
      color: rgba(138,157,212,0.7);
      pointer-events: none;
      z-index: 2;
    }
    .panel-info {
      position: absolute;
      bottom: 10px; left: 12px;
      font-size: 11px;
      color: rgba(255,180,70,0.8);
      pointer-events: none;
      z-index: 2;
    }
  </style>
</head>
<body>
<div class="app">
  <div class="toolbar">
    <label>2D 字母:</label>
    <select id="letter-select"></select>
    <button id="add-handle-btn">+ 手柄模式</button>
    <button id="clear-handles-btn">清除手柄</button>
    <button id="confirm-btn">确定选择</button>
    <span style="font-size:13px;color:#8a9dd4;" id="handle-count">0 个手柄</span>
    <span class="spacer"></span>
    <button id="drag-btn" class="primary">开始拖动</button>
    <button id="ruppert-btn">Ruppert 三角化</button>
    <span class="status" id="status-text">选择字母开始</span>
  </div>
  <div class="main">
    <div class="panel" id="left-panel">
      <div class="panel-label">2D 模型 — 点击面选中，拖动变形</div>
      <canvas id="model-canvas"></canvas>
      <div class="panel-info" id="model-info"></div>
    </div>
    <div class="panel" id="right-panel">
      <div class="panel-label">变形结果 — 也可点击选中、拖动</div>
      <canvas id="result-canvas"></canvas>
      <div class="panel-info" id="result-info"></div>
    </div>
  </div>
</div>

<script>
(function() {
  // ==================== DOM ====================
  const letterSelect = document.getElementById('letter-select');
  const addHandleBtn = document.getElementById('add-handle-btn');
  const clearHandlesBtn = document.getElementById('clear-handles-btn');
  const confirmBtn = document.getElementById('confirm-btn');
  const handleCountEl = document.getElementById('handle-count');
  const dragBtn = document.getElementById('drag-btn');
  const ruppertBtn = document.getElementById('ruppert-btn');
  const statusText = document.getElementById('status-text');
  const modelCanvas = document.getElementById('model-canvas');
  const resultCanvas = document.getElementById('result-canvas');
  const modelInfo = document.getElementById('model-info');
  const resultInfo = document.getElementById('result-info');

  // ==================== Three.js 场景 ====================
  const modelRenderer = new THREE.WebGLRenderer({ canvas: modelCanvas, antialias: true, alpha: true });
  const resultRenderer = new THREE.WebGLRenderer({ canvas: resultCanvas, antialias: true, alpha: true });
  modelRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  resultRenderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  const modelScene = new THREE.Scene();
  const resultScene = new THREE.Scene();
  modelScene.background = new THREE.Color(0x08101d);
  resultScene.background = new THREE.Color(0x091120);

  // 左侧模型相机：2D 正交视图，固定不可旋转
  const modelCamera = new THREE.OrthographicCamera(-1.2, 1.2, 1.2, -1.2, 0.1, 10);
  modelCamera.position.set(0, 0, 5);
  modelCamera.lookAt(0, 0, 0);

  // 右侧结果相机：2D 正交视图，不可旋转
  const resultCamera = new THREE.OrthographicCamera(-1.2, 1.2, 1.2, -1.2, 0.1, 10);
  resultCamera.position.set(0, 0, 5);
  resultCamera.lookAt(0, 0, 0);

  // 光照
  const addLights = (scene) => {
    scene.add(new THREE.AmbientLight(0xffffff, 0.7));
    const d = new THREE.DirectionalLight(0xffffff, 0.8);
    d.position.set(2, 3, 4);
    scene.add(d);
    const d2 = new THREE.DirectionalLight(0xffffff, 0.3);
    d2.position.set(-2, -1, -2);
    scene.add(d2);
  };
  addLights(modelScene);
  addLights(resultScene);

  // ==================== 状态 ====================
  let currentMeshData = null;       // { positions: [[x,y,z],...], faces: [[a,b,c],...] }
  let restPositions = null;         // 原始顶点位置 (deep copy)

  // 每窗口独立状态
  function makePanelState() {
    return {
      handles: [],                  // [{ faceIndex, indices, restCentroid, currentCentroid }]
      handlesConfirmed: false,
      handleMode: false,
      dragMode: false,
      isDragging: false,
      draggedHandle: null,
      deformedPositions: null,
      modelGroup: null
    };
  }
  let L = makePanelState(); // 左侧
  let R = makePanelState(); // 右侧

  const raycaster = new THREE.Raycaster();
  const mouse = new THREE.Vector2();

  function setStatus(msg, color) {
    statusText.textContent = msg;
    statusText.style.color = color || '#5a6791';
  }

  // ==================== OBJ 模型加载 ====================
  function loadOBJLetter(letter) {
    return new Promise((resolve, reject) => {
      const loader = new THREE.OBJLoader();
      loader.load('assets/charaters/' + letter + '_2d.obj',
        (obj) => { resolve(obj); },
        undefined,
        () => { reject(new Error('加载失败: ' + letter)); }
      );
    });
  }

  function extractMeshData(geometry) {
    // 兼容旧版 Geometry (有 vertices/faces) 和新版 BufferGeometry (有 attributes)
    let positions, faces;

    if (geometry.attributes && geometry.attributes.position) {
      // BufferGeometry
      const posAttr = geometry.attributes.position;
      const idx = geometry.index;
      positions = [];
      for (let i = 0; i < posAttr.count; i++) {
        positions.push([posAttr.getX(i), posAttr.getY(i), posAttr.getZ(i)]);
      }
      if (idx) {
        faces = [];
        const arr = idx.array;
        for (let i = 0; i < arr.length; i += 3) {
          faces.push([arr[i], arr[i+1], arr[i+2]]);
        }
      } else {
        faces = [];
        for (let i = 0; i < posAttr.count; i += 3) {
          faces.push([i, i+1, i+2]);
        }
      }
    } else if (geometry.vertices && geometry.faces) {
      // 旧版 Geometry
      positions = geometry.vertices.map(v => [v.x, v.y, v.z]);
      faces = geometry.faces.map(f => [f.a, f.b, f.c]);
    } else {
      throw new Error('无法解析几何体数据');
    }

    return { positions, faces };
  }

  function buildModelVisual(positions, faces) {
    const group = new THREE.Group();

    // 实心面
    const geom = new THREE.BufferGeometry();
    const flatPos = new Float32Array(positions.length * 3);
    for (let i = 0; i < positions.length; i++) {
      flatPos[i*3] = positions[i][0];
      flatPos[i*3+1] = positions[i][1];
      flatPos[i*3+2] = positions[i][2];
    }
    geom.setAttribute('position', new THREE.Float32BufferAttribute(flatPos, 3));
    const flatIdx = new Uint32Array(faces.length * 3);
    for (let i = 0; i < faces.length; i++) {
      flatIdx[i*3] = faces[i][0];
      flatIdx[i*3+1] = faces[i][1];
      flatIdx[i*3+2] = faces[i][2];
    }
    geom.setIndex(new THREE.BufferAttribute(flatIdx, 1));
    geom.computeVertexNormals();

    const mesh = new THREE.Mesh(geom, new THREE.MeshStandardMaterial({
      color: 0x7fa7ff, roughness: 0.5, metalness: 0.05, side: THREE.DoubleSide
    }));
    group.add(mesh);

    // 线框
    const wireGeom = new THREE.BufferGeometry();
    const edgeSet = new Set();
    const segments = [];
    function addEdge(a, b) {
      const key = a < b ? a + '_' + b : b + '_' + a;
      if (edgeSet.has(key)) return;
      edgeSet.add(key);
      segments.push(positions[a][0], positions[a][1], positions[a][2]);
      segments.push(positions[b][0], positions[b][1], positions[b][2]);
    }
    for (let i = 0; i < faces.length; i++) {
      addEdge(faces[i][0], faces[i][1]);
      addEdge(faces[i][1], faces[i][2]);
      addEdge(faces[i][2], faces[i][0]);
    }
    wireGeom.setAttribute('position', new THREE.Float32BufferAttribute(segments, 3));
    const wire = new THREE.LineSegments(wireGeom,
      new THREE.LineBasicMaterial({ color: 0x1f2f55, transparent: true, opacity: 0.6 }));
    group.add(wire);

    return group;
  }

  function clearGroup(scene, obj) {
    if (obj && obj.parent) obj.parent.remove(obj);
  }

  // ==================== 手柄可视化 ====================
  function updateHandleVisuals() {
    if (!currentMeshData) return;
    const positions = deformedPositions || currentMeshData.positions;
    const faces = currentMeshData.faces;

    // 完全重建模型组（基础网格 + 线框 + 手柄）
    clearGroup(modelScene, currentModelGroup);
    const group = new THREE.Group();

    // 基础面
    const geom = new THREE.BufferGeometry();
    const flatPos = new Float32Array(positions.length * 3);
    for (let i = 0; i < positions.length; i++) {
      flatPos[i*3]=positions[i][0]; flatPos[i*3+1]=positions[i][1]; flatPos[i*3+2]=positions[i][2];
    }
    geom.setAttribute('position', new THREE.Float32BufferAttribute(flatPos, 3));
    const flatIdx = new Uint32Array(faces.length * 3);
    for (let i = 0; i < faces.length; i++) {
      flatIdx[i*3]=faces[i][0]; flatIdx[i*3+1]=faces[i][1]; flatIdx[i*3+2]=faces[i][2];
    }
    geom.setIndex(new THREE.BufferAttribute(flatIdx, 1));
    geom.computeVertexNormals();
    group.add(new THREE.Mesh(geom, new THREE.MeshStandardMaterial({
      color: 0x7fa7ff, roughness: 0.5, metalness: 0.05, side: THREE.DoubleSide
    })));

    // 线框
    const edgeSet = new Set(); const segs = [];
    for (let i = 0; i < faces.length; i++) {
      for (const [u,v] of [[faces[i][0],faces[i][1]],[faces[i][1],faces[i][2]],[faces[i][2],faces[i][0]]]) {
        const k = u<v ? u+'_'+v : v+'_'+u;
        if (edgeSet.has(k)) continue; edgeSet.add(k);
        segs.push(positions[u][0],positions[u][1],positions[u][2],positions[v][0],positions[v][1],positions[v][2]);
      }
    }
    const wg = new THREE.BufferGeometry();
    wg.setAttribute('position', new THREE.Float32BufferAttribute(segs, 3));
    group.add(new THREE.LineSegments(wg, new THREE.LineBasicMaterial({ color: 0x1f2f55, transparent:true, opacity:0.6 })));

    // 手柄面高亮
    for (let i = 0; i < handles.length; i++) {
      const h = handles[i];
      const [v0,v1,v2] = h.indices;
      const p0=positions[v0],p1=positions[v1],p2=positions[v2];
      const fg = new THREE.BufferGeometry();
      fg.setAttribute('position', new THREE.Float32BufferAttribute([p0[0],p0[1],p0[2],p1[0],p1[1],p1[2],p2[0],p2[1],p2[2]],3));
      fg.setIndex([0,1,2]);
      const fm = new THREE.Mesh(fg, new THREE.MeshBasicMaterial({ color:0xffd700, transparent:true, opacity:(h===draggedHandle)?0.5:0.35, side:THREE.DoubleSide, depthTest:true, depthWrite:false }));
      fm.userData = { isHandle: true, handleIndex: i };
      group.add(fm);
    }

    currentModelGroup = group;
    modelScene.add(group);
    handleCountEl.textContent = handles.length + ' 个面手柄';
  }

  // 可视化右侧：镜像左侧模型（使用 deformedPositions 或原始位置）
  function updateDeformedVisual() {
    clearGroup(resultScene, currentDeformedGroup);
    if (!currentMeshData) { currentDeformedGroup = null; return; }

    const positions = deformedPositions || currentMeshData.positions;
    const faces = currentMeshData.faces;
    const group = new THREE.Group();

    const geom = new THREE.BufferGeometry();
    const flatPos = new Float32Array(positions.length * 3);
    for (let i = 0; i < positions.length; i++) {
      flatPos[i*3] = positions[i][0];
      flatPos[i*3+1] = positions[i][1];
      flatPos[i*3+2] = positions[i][2];
    }
    geom.setAttribute('position', new THREE.Float32BufferAttribute(flatPos, 3));
    const flatIdx = new Uint32Array(faces.length * 3);
    for (let i = 0; i < faces.length; i++) {
      flatIdx[i*3] = faces[i][0]; flatIdx[i*3+1] = faces[i][1]; flatIdx[i*3+2] = faces[i][2];
    }
    geom.setIndex(new THREE.BufferAttribute(flatIdx, 1));
    geom.computeVertexNormals();
    group.add(new THREE.Mesh(geom, new THREE.MeshStandardMaterial({
      color: 0x7fa7ff, roughness: 0.5, metalness: 0.05, side: THREE.DoubleSide
    })));

    // 线框
    const edgeSet = new Set(); const segs = [];
    for (let i = 0; i < faces.length; i++) {
      for (const [u,v] of [[faces[i][0],faces[i][1]],[faces[i][1],faces[i][2]],[faces[i][2],faces[i][0]]]) {
        const k = u<v ? u+'_'+v : v+'_'+u;
        if (edgeSet.has(k)) continue; edgeSet.add(k);
        segs.push(positions[u][0],positions[u][1],positions[u][2],positions[v][0],positions[v][1],positions[v][2]);
      }
    }
    const wg = new THREE.BufferGeometry();
    wg.setAttribute('position', new THREE.Float32BufferAttribute(segs, 3));
    group.add(new THREE.LineSegments(wg, new THREE.LineBasicMaterial({ color: 0x1f2f55, transparent:true, opacity:0.6 })));

    // 手柄面高亮
    for (let i = 0; i < handles.length; i++) {
      const h = handles[i];
      const [v0,v1,v2] = h.indices;
      const p0=positions[v0],p1=positions[v1],p2=positions[v2];
      const fg = new THREE.BufferGeometry();
      fg.setAttribute('position', new THREE.Float32BufferAttribute([p0[0],p0[1],p0[2],p1[0],p1[1],p1[2],p2[0],p2[1],p2[2]],3));
      fg.setIndex([0,1,2]);
      const fm = new THREE.Mesh(fg, new THREE.MeshBasicMaterial({ color:0xffd700, transparent:true, opacity:0.35, side:THREE.DoubleSide, depthTest:true, depthWrite:false }));
      fm.userData = { isHandle: true, handleIndex: i };
      group.add(fm);
    }

    currentDeformedGroup = group;
    resultScene.add(group);
  }


  // ==================== 向量工具 ====================
  function cross3(a, b) {
    return [a[1]*b[2] - a[2]*b[1], a[2]*b[0] - a[0]*b[2], a[0]*b[1] - a[1]*b[0]];
  }
  function dot3(a, b) {
    return a[0]*b[0] + a[1]*b[1] + a[2]*b[2];
  }
  function norm3(v) {
    const len = Math.sqrt(v[0]*v[0] + v[1]*v[1] + v[2]*v[2]);
    if (len < 1e-12) return [1, 0, 0];
    return [v[0]/len, v[1]/len, v[2]/len];
  }
  function vec3Sub(a, b) { return [a[0]-b[0], a[1]-b[1], a[2]-b[2]]; }
  function vec3Add(a, b) { return [a[0]+b[0], a[1]+b[1], a[2]+b[2]]; }
  function vec3Scale(v, s) { return [v[0]*s, v[1]*s, v[2]*s]; }

  // ==================== 鼠标交互 ====================
  function getCanvasCoords(canvas, e) {
    const rect = canvas.getBoundingClientRect();
    return {
      x: ((e.clientX - rect.left) / rect.width) * 2 - 1,
      y: -((e.clientY - rect.top) / rect.height) * 2 + 1
    };
  }

  modelCanvas.addEventListener('click', (e) => {
    if (!handleMode || handlesConfirmed || !currentMeshData || isDragging) return;

    const coords = getCanvasCoords(modelCanvas, e);
    mouse.set(coords.x, coords.y);
    raycaster.setFromCamera(mouse, modelCamera);

    // 对当前模型组做射线检测
    if (!currentModelGroup) return;
    const meshes = [];
    currentModelGroup.children.forEach(c => {
      if (c.isMesh && !c.userData.isHandle) meshes.push(c);
    });
    const intersects = raycaster.intersectObjects(meshes, false);

    if (intersects.length === 0) return;

    const hit = intersects[0];
    const positions = deformedPositions || currentMeshData.positions;

    // 根据射线相交的面索引获取三角面
    const faceIdx = hit.faceIndex;
    if (faceIdx === undefined || faceIdx >= currentMeshData.faces.length) return;
    const face = currentMeshData.faces[faceIdx];
    const [v0, v1, v2] = face;

    // 计算面重心
    const cx = (positions[v0][0] + positions[v1][0] + positions[v2][0]) / 3;
    const cy = (positions[v0][1] + positions[v1][1] + positions[v2][1]) / 3;
    const cz = (positions[v0][2] + positions[v1][2] + positions[v2][2]) / 3;

    // 检查此面是否已作为手柄
    const existing = handles.findIndex(h => h.faceIndex === faceIdx);
    if (existing >= 0) {
      handles.splice(existing, 1);
    } else {
      handles.push({
        faceIndex: faceIdx,
        indices: [v0, v1, v2],
        restCentroid: [cx, cy, cz],
        currentCentroid: [cx, cy, cz]
      });
    }
    updateHandleVisuals();
    updateDeformedVisual();
  });

  modelCanvas.addEventListener('mousedown', (e) => {
    if (!currentModelGroup || handles.length === 0) return;
    if (!handleMode && !dragMode) return;

    const coords = getCanvasCoords(modelCanvas, e);
    mouse.set(coords.x, coords.y);
    raycaster.setFromCamera(mouse, modelCamera);

    // 检测手柄球
    const handleMeshes = [];
    currentModelGroup.children.forEach(c => {
      if (c.userData && c.userData.isHandle) handleMeshes.push(c);
    });
    const intersects = raycaster.intersectObjects(handleMeshes, false);
    if (intersects.length > 0) {
      isDragging = true;
      const idx = intersects[0].object.userData.handleIndex;
      draggedHandle = handles[idx];
      updateHandleVisuals();
    }
  });

  modelCanvas.addEventListener('mousemove', (e) => {
    if (!isDragging || !draggedHandle || !currentModelGroup) return;

    const coords = getCanvasCoords(modelCanvas, e);
    mouse.set(coords.x, coords.y);
    raycaster.setFromCamera(mouse, modelCamera);

    // 在垂直于相机的平面上移动
    const camDir = new THREE.Vector3();
    modelCamera.getWorldDirection(camDir);
    const plane = new THREE.Plane(new THREE.Vector3(camDir.x, camDir.y, camDir.z).negate(), 0);
    const intersect = new THREE.Vector3();
    raycaster.ray.intersectPlane(plane, intersect);

    if (intersect) {
      const oldC = draggedHandle.currentCentroid;
      const newC = [intersect.x, intersect.y, intersect.z];
      const delta = [newC[0] - oldC[0], newC[1] - oldC[1], newC[2] - oldC[2]];

      if (!deformedPositions) {
        deformedPositions = restPositions.map(p => [p[0], p[1], p[2]]);
      }

      if (handlesConfirmed) {
        // 整体移动：所有手柄同步平移
        for (const h of handles) {
          h.currentCentroid[0] += delta[0];
          h.currentCentroid[1] += delta[1];
          h.currentCentroid[2] += delta[2];
          for (const vi of h.indices) {
            deformedPositions[vi][0] += delta[0];
            deformedPositions[vi][1] += delta[1];
            deformedPositions[vi][2] += delta[2];
          }
        }
      } else {
        // 独立移动
        draggedHandle.currentCentroid = newC;
        for (const vi of draggedHandle.indices) {
          deformedPositions[vi][0] += delta[0];
          deformedPositions[vi][1] += delta[1];
          deformedPositions[vi][2] += delta[2];
        }
      }
      updateHandleVisuals();
      updateDeformedVisual();
    }
  });

  window.addEventListener('mouseup', () => {
    if (isDragging) {
      isDragging = false;
      draggedHandle = null;
      updateHandleVisuals();
      updateDeformedVisual();
    }
  });

  // ==================== 右侧窗口交互 ====================
  const resultRaycaster = new THREE.Raycaster();
  const resultMouse = new THREE.Vector2();

  function getResultGroup() { return currentDeformedGroup; }

  resultCanvas.addEventListener('click', (e) => {
    if (!handleMode || handlesConfirmed || !currentMeshData || isDragging) return;
    const coords = getCanvasCoords(resultCanvas, e);
    resultMouse.set(coords.x, coords.y);
    resultRaycaster.setFromCamera(resultMouse, resultCamera);

    const meshes = [];
    if (currentDeformedGroup) {
      currentDeformedGroup.children.forEach(c => {
        if (c.isMesh && !c.userData.isHandle) meshes.push(c);
      });
    }
    if (meshes.length === 0) return;
    const intersects = resultRaycaster.intersectObjects(meshes, false);
    if (intersects.length === 0) return;

    const hit = intersects[0];
    const faceIdx = hit.faceIndex;
    if (faceIdx === undefined || faceIdx >= currentMeshData.faces.length) return;
    const face = currentMeshData.faces[faceIdx];
    const [v0, v1, v2] = face;

    const positions = deformedPositions || currentMeshData.positions;
    const cx = (positions[v0][0] + positions[v1][0] + positions[v2][0]) / 3;
    const cy = (positions[v0][1] + positions[v1][1] + positions[v2][1]) / 3;
    const cz = (positions[v0][2] + positions[v1][2] + positions[v2][2]) / 3;

    const existing = handles.findIndex(h => h.faceIndex === faceIdx);
    if (existing >= 0) {
      handles.splice(existing, 1);
    } else {
      handles.push({
        faceIndex: faceIdx,
        indices: [v0, v1, v2],
        restCentroid: [cx, cy, cz],
        currentCentroid: [cx, cy, cz]
      });
    }
    updateHandleVisuals();
    updateDeformedVisual();
  });

  resultCanvas.addEventListener('mousedown', (e) => {
    if (!currentMeshData || handles.length === 0) return;
    if (!handleMode && !dragMode) return;

    const coords = getCanvasCoords(resultCanvas, e);
    resultMouse.set(coords.x, coords.y);
    resultRaycaster.setFromCamera(resultMouse, resultCamera);

    const handleMeshes = [];
    if (currentDeformedGroup) {
      currentDeformedGroup.children.forEach(c => {
        if (c.userData && c.userData.isHandle) handleMeshes.push(c);
      });
    }
    const intersects = resultRaycaster.intersectObjects(handleMeshes, false);
    if (intersects.length > 0) {
      isDragging = true;
      const idx = intersects[0].object.userData.handleIndex;
      draggedHandle = handles[idx];
      updateHandleVisuals();
      updateDeformedVisual();
    }
  });

  resultCanvas.addEventListener('mousemove', (e) => {
    if (!isDragging || !draggedHandle) return;

    // reuse existing delta calculation from model mousemove
    // the actual delta is already applied; just update visuals
    updateDeformedVisual();
  });

  // ==================== 按钮事件 ====================
  addHandleBtn.addEventListener('click', () => {
    if (handlesConfirmed) {
      setStatus('请先取消组合（点击"取消组合"按钮）', '#ffd38a');
      return;
    }
    handleMode = !handleMode;
    if (handleMode) {
      addHandleBtn.textContent = '✓ 手柄模式';
      addHandleBtn.style.background = '#1a2848';
      addHandleBtn.style.borderColor = '#ff6b35';
      setStatus('点击模型放置/移除手柄，拖拽手柄调整位置', '#ffb446');
    } else {
      addHandleBtn.textContent = '+ 手柄模式';
      addHandleBtn.style.background = '';
      addHandleBtn.style.borderColor = '';
      setStatus('手柄模式已关闭', '#5a6791');
    }
  });

  clearHandlesBtn.addEventListener('click', () => {
    handles = [];
    handlesConfirmed = false;
    confirmBtn.textContent = '确定选择';
    confirmBtn.style.background = '';
    confirmBtn.style.borderColor = '';
    updateHandleVisuals();
    setStatus('手柄已清除', '#5a6791');
  });

  confirmBtn.addEventListener('click', () => {
    if (handles.length === 0) {
      setStatus('请先放置手柄', '#ffd38a');
      return;
    }
    handlesConfirmed = !handlesConfirmed;
    if (handlesConfirmed) {
      confirmBtn.textContent = '取消组合';
      confirmBtn.style.background = '#1a2848';
      confirmBtn.style.borderColor = '#ffd700';
      handleMode = false;
      addHandleBtn.textContent = '+ 手柄模式';
      addHandleBtn.style.background = '';
      addHandleBtn.style.borderColor = '';
      setStatus('手柄已组合为整体，拖拽任一▼整体移动', '#89f0b6');
    } else {
      confirmBtn.textContent = '确定选择';
      confirmBtn.style.background = '';
      confirmBtn.style.borderColor = '';
      setStatus('已取消组合，手柄恢复独立', '#8cc4ff');
    }
  });

  // ==================== 拖动模式 ====================
  dragBtn.addEventListener('click', () => {
    if (handles.length === 0) {
      setStatus('请先放置手柄', '#ffd38a');
      return;
    }
    dragMode = !dragMode;
    if (dragMode) {
      dragBtn.textContent = '结束拖动';
      dragBtn.style.background = 'linear-gradient(135deg, #cc5500 0%, #ff6b35 100%)';
      handleMode = false;
      addHandleBtn.textContent = '+ 手柄模式';
      addHandleBtn.style.background = '';
      addHandleBtn.style.borderColor = '';
      setStatus('拖动模式：拖拽手柄▼变形（左右窗口均可操作）', '#89f0b6');
    } else {
      dragBtn.textContent = '开始拖动';
      dragBtn.style.background = '';
      setStatus('拖动已结束', '#8cc4ff');
    }
  });

  // ==================== Ruppert 三角化 ====================

  function circumcenter2D(a, b, c) {
    // 计算三角形 (a,b,c) 的 2D 外接圆圆心
    const ax = a[0], ay = a[1], bx = b[0], by = b[1], cx = c[0], cy = c[1];
    const D = 2 * (ax * (by - cy) + bx * (cy - ay) + cx * (ay - by));
    if (Math.abs(D) < 1e-12) return null;
    const ax2 = ax * ax + ay * ay;
    const by2 = bx * bx + by * by;
    const cx2 = cx * cx + cy * cy;
    const ux = (ax2 * (by - cy) + by2 * (cy - ay) + cx2 * (ay - by)) / D;
    const uy = (ax2 * (cx - bx) + by2 * (ax - cx) + cx2 * (bx - ax)) / D;
    return [ux, uy, 0];
  }

  function circumradius2D(a, b, c) {
    const ax = a[0], ay = a[1], bx = b[0], by = b[1], cx = c[0], cy = c[1];
    const ab = Math.hypot(bx - ax, by - ay);
    const bc = Math.hypot(cx - bx, cy - by);
    const ca = Math.hypot(ax - cx, cy - ay);
    const s = (ab + bc + ca) / 2;
    const area = Math.sqrt(Math.max(0, s * (s - ab) * (s - bc) * (s - ca)));
    if (area < 1e-12) return Infinity;
    return (ab * bc * ca) / (4 * area);
  }

  function shortestEdge2D(a, b, c) {
    const dx1 = b[0] - a[0], dy1 = b[1] - a[1];
    const dx2 = c[0] - b[0], dy2 = c[1] - b[1];
    const dx3 = a[0] - c[0], dy3 = a[1] - c[1];
    return Math.min(
      Math.sqrt(dx1 * dx1 + dy1 * dy1),
      Math.sqrt(dx2 * dx2 + dy2 * dy2),
      Math.sqrt(dx3 * dx3 + dy3 * dy3)
    );
  }

  function minAngle2D(a, b, c) {
    const ab = Math.hypot(b[0] - a[0], b[1] - a[1]);
    const bc = Math.hypot(c[0] - b[0], c[1] - b[1]);
    const ca = Math.hypot(a[0] - c[0], a[1] - c[1]);
    // 余弦定理求各角
    const cosA = (ab * ab + ca * ca - bc * bc) / (2 * ab * ca + 1e-12);
    const cosB = (ab * ab + bc * bc - ca * ca) / (2 * ab * bc + 1e-12);
    const cosC = (bc * bc + ca * ca - ab * ab) / (2 * bc * ca + 1e-12);
    const clamp = v => Math.max(-1, Math.min(1, v));
    const angleA = Math.acos(clamp(cosA));
    const angleB = Math.acos(clamp(cosB));
    const angleC = Math.acos(clamp(cosC));
    return Math.min(angleA, angleB, angleC);
  }

  function edgeKey(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

  /** 从 faces 提取边界边（只被一个三角形使用的边） */
  function extractBoundaryEdges(faces) {
    const ecount = new Map();
    const efaces = new Map();
    for (let fi = 0; fi < faces.length; fi++) {
      const [a, b, c] = faces[fi];
      for (const [u, v] of [[a,b],[b,c],[c,a]]) {
        const k = edgeKey(u, v);
        ecount.set(k, (ecount.get(k) || 0) + 1);
        if (!efaces.has(k)) efaces.set(k, []);
        efaces.get(k).push(fi);
      }
    }
    const boundary = new Set();
    for (const [k, cnt] of ecount) {
      if (cnt === 1) boundary.add(k);
    }
    return boundary;
  }

  /** 检查点 p 是否侵入边界边 (u,v) 的直径圆 */
  function encroachesEdge(p, u, v, positions) {
    const pu = positions[u], pv = positions[v];
    const mx = (pu[0] + pv[0]) / 2, my = (pu[1] + pv[1]) / 2;
    const dx = p[0] - mx, dy = p[1] - my;
    const halfLen = Math.hypot(pv[0] - pu[0], pv[1] - pu[1]) / 2;
    return (dx * dx + dy * dy) < halfLen * halfLen * 1.001; // 加点容忍
  }

  /** 标准 incircle 测试：d 是否在三角形 abc 的外接圆内（CCW 时 >0 表示在内） */
  function incircle2D(ax, ay, bx, by, cx, cy, dx, dy) {
    const adx = ax - dx, ady = ay - dy;
    const bdx = bx - dx, bdy = by - dy;
    const cdx = cx - dx, cdy = cy - dy;
    const al = adx*adx + ady*ady;
    const bl = bdx*bdx + bdy*bdy;
    const cl = cdx*cdx + cdy*cdy;
    return al*(bdx*cdy - bdy*cdx)
         - bl*(adx*cdy - ady*cdx)
         + cl*(adx*bdy - ady*bdx);
  }

  function orient2D(ax, ay, bx, by, cx, cy) {
    return (bx - ax)*(cy - ay) - (by - ay)*(cx - ax);
  }

  /** 构建 edge → [fi, fi] 映射 */
  function buildEdgeFaceMap(triangles) {
    const map = new Map();
    for (let fi = 0; fi < triangles.length; fi++) {
      const [a, b, c] = triangles[fi];
      for (const [u, v] of [[a,b],[b,c],[c,a]]) {
        const k = edgeKey(u, v);
        if (!map.has(k)) map.set(k, []);
        map.get(k).push(fi);
      }
    }
    return map;
  }

  /** 找到包含边界边 (u,v) 的三角形索引 */
  function findFaceWithEdge(tri, u, v) {
    for (let fi = 0; fi < tri.length; fi++) {
      const [a, b, c] = tri[fi];
      if ((a===u||a===v) && (b===u||b===v) && (c===u||c===v)) {
        // 这个面包含 u 和 v（但不一定是边）
        const hasU = (a===u||b===u||c===u);
        const hasV = (a===v||b===v||c===v);
        if (hasU && hasV) return fi;
      }
    }
    return -1;
  }

  function ruppertRefine(positions, faces, minAngleDeg, maxIter) {
    const targetMinAngle = minAngleDeg * Math.PI / 180;
    const B = 1.0 / Math.sin(targetMinAngle * 0.5);

    let pos = positions.map(p => [p[0], p[1], 0]);
    let tri = faces.map(f => [f[0], f[1], f[2]]);
    const boundaryEdges = extractBoundaryEdges(tri);

    // 确保所有面是 CCW
    for (let fi = 0; fi < tri.length; fi++) {
      const [a, b, c] = tri[fi];
      if (orient2D(pos[a][0], pos[a][1], pos[b][0], pos[b][1], pos[c][0], pos[c][1]) < 0) {
        tri[fi] = [a, c, b]; // 翻转为 CCW
      }
    }

    for (let iter = 0; iter < maxIter; iter++) {
      // 找最差三角形
      let worstIdx = -1, worstAng = Infinity;
      for (let fi = 0; fi < tri.length; fi++) {
        const [a, b, c] = tri[fi];
        const pa=pos[a], pb=pos[b], pc=pos[c];
        const minAng = minAngle2D(pa, pb, pc);
        if (minAng < worstAng) { worstAng = minAng; worstIdx = fi; }
      }

      if (worstIdx < 0 || worstAng >= targetMinAngle) break;

      const [a, b, c] = tri[worstIdx];
      const pa=pos[a], pb=pos[b], pc=pos[c];
      const R = circumradius2D(pa, pb, pc);
      const l = shortestEdge2D(pa, pb, pc);
      if (R / l < B && worstAng >= targetMinAngle * 0.6) break;

      const cc = circumcenter2D(pa, pb, pc);
      if (!cc) continue;

      // === 边界保护 ===
      let encroached = false;
      for (const ek of boundaryEdges) {
        const [u, v] = ek.split('_').map(Number);
        if (encroachesEdge(cc, u, v, pos)) {
          encroached = true;

          // 分裂边界边：在中点插入新点
          const pu = pos[u], pv = pos[v];
          const mid = [(pu[0]+pv[0])/2, (pu[1]+pv[1])/2, 0];
          const newIdx = pos.length;
          pos.push(mid);

          // 更新边界
          boundaryEdges.delete(ek);
          boundaryEdges.add(edgeKey(u, newIdx));
          boundaryEdges.add(edgeKey(v, newIdx));

          // 找到包含此边界边的三角形，拆分为两个
          const faceIdx = findFaceWithEdge(tri, u, v);
          if (faceIdx >= 0) {
            const [fv0, fv1, fv2] = tri[faceIdx];
            const other = [fv0,fv1,fv2].find(x => x !== u && x !== v);
            tri[faceIdx] = [u, other, newIdx];
            tri.push([v, newIdx, other]);
          }
          break;
        }
      }
      if (encroached) continue;

      // === 插入 Steiner 点 ===
      const newIdx = pos.length;
      pos.push(cc);

      // 拆分原三角形为 3 个子三角形（保持 CCW 朝向）
      tri[worstIdx] = [a, b, newIdx];
      tri.push([b, c, newIdx]);
      tri.push([c, a, newIdx]);

      // === Delaunay 边翻转 ===
      let flipped = true;
      while (flipped) {
        flipped = false;
        const efm = buildEdgeFaceMap(tri);
        for (const [k, fiArr] of efm) {
          if (fiArr.length !== 2) continue;
          const [u, v] = k.split('_').map(Number);
          const f0 = tri[fiArr[0]], f1 = tri[fiArr[1]];
          // 找出不共享的顶点
          const others = [];
          for (const x of f0) if (x !== u && x !== v) others.push(x);
          for (const x of f1) if (x !== u && x !== v) others.push(x);
          if (others.length !== 2) continue;
          const [p, q] = others;

          const v_other_f0 = f0.find(x => x !== u && x !== v);
          const v_other_f1 = f1.find(x => x !== u && x !== v);
          if (v_other_f0 === undefined || v_other_f1 === undefined) continue;

          // incircle 检查：q 是否在 (u,v,p) 的外接圆内？
          const ic = incircle2D(
            pos[u][0],pos[u][1], pos[v][0],pos[v][1],
            pos[p][0],pos[p][1], pos[q][0],pos[q][1]
          );
          // (u,v,p) 是 CCW 的，ic > 0 表示 q 在内 → 需要翻转
          if (ic > 1e-10) {
            tri[fiArr[0]] = [u, p, q];
            tri[fiArr[1]] = [v, q, p];
            flipped = true;
          }
        }
      }
    }

    return { positions: pos, faces: tri };
  }

  ruppertBtn.addEventListener('click', () => {
    if (!currentMeshData) {
      setStatus('请先选择字母', '#ffd38a');
      return;
    }

    const meshData = currentMeshData;
    setStatus('Ruppert 三角化中...', '#ffb446');

    // 延迟到下一帧
    setTimeout(() => {
      try {
        const refined = ruppertRefine(meshData.positions, meshData.faces, 25, 200);

        // 显示在右侧
        clearGroup(resultScene, currentDeformedGroup);

        const positions = refined.positions;
        const faces = refined.faces;
        const group = new THREE.Group();

        // 实心面
        const geom = new THREE.BufferGeometry();
        const flatPos = new Float32Array(positions.length * 3);
        for (let i = 0; i < positions.length; i++) {
          flatPos[i*3] = positions[i][0];
          flatPos[i*3+1] = positions[i][1];
          flatPos[i*3+2] = positions[i][2];
        }
        geom.setAttribute('position', new THREE.Float32BufferAttribute(flatPos, 3));
        const flatIdx = new Uint32Array(faces.length * 3);
        for (let i = 0; i < faces.length; i++) {
          flatIdx[i*3] = faces[i][0];
          flatIdx[i*3+1] = faces[i][1];
          flatIdx[i*3+2] = faces[i][2];
        }
        geom.setIndex(new THREE.BufferAttribute(flatIdx, 1));
        geom.computeVertexNormals();
        group.add(new THREE.Mesh(geom, new THREE.MeshStandardMaterial({
          color: 0x7fa7ff, roughness: 0.5, metalness: 0.05, side: THREE.DoubleSide
        })));

        // 线框
        const wireGeom = new THREE.BufferGeometry();
        const edgeSet = new Set();
        const segs = [];
        function addE(a, b) {
          const key = a < b ? a + '_' + b : b + '_' + a;
          if (edgeSet.has(key)) return;
          edgeSet.add(key);
          segs.push(positions[a][0], positions[a][1], positions[a][2]);
          segs.push(positions[b][0], positions[b][1], positions[b][2]);
        }
        for (let i = 0; i < faces.length; i++) {
          addE(faces[i][0], faces[i][1]);
          addE(faces[i][1], faces[i][2]);
          addE(faces[i][2], faces[i][0]);
        }
        wireGeom.setAttribute('position', new THREE.Float32BufferAttribute(segs, 3));
        group.add(new THREE.LineSegments(wireGeom,
          new THREE.LineBasicMaterial({ color: 0x1f2f55, transparent: true, opacity: 0.6 })));

        currentDeformedGroup = group;
        resultScene.add(group);

        resultInfo.textContent = 'Ruppert: ' + positions.length + ' 顶点 | ' + faces.length + ' 面 (最小角 ≥ 25°)';
        setStatus('Ruppert 三角化完成', '#89f0b6');
      } catch (err) {
        console.error(err);
        setStatus('三角化失败: ' + err.message, '#ff9d9d');
      }
    }, 10);
  });

  // ==================== 字母选择 ====================
  async function loadLetter(letter) {
    setStatus('加载中...', '#ffd38a');
    try {
      const obj = await loadOBJLetter(letter);

      // 从 OBJ 对象提取所有 mesh 的几何数据
      const allPos = [];
      const allFaces = [];
      let vertOffset = 0;
      obj.traverse(function(child) {
        if (!child.isMesh || !child.geometry) return;
        const data = extractMeshData(child.geometry);
        for (const p of data.positions) {
          allPos.push([p[0], p[1], p[2]]);
        }
        for (const f of data.faces) {
          allFaces.push([f[0] + vertOffset, f[1] + vertOffset, f[2] + vertOffset]);
        }
        vertOffset += data.positions.length;
      });

      if (allPos.length === 0) throw new Error('模型无数据');
      const meshData = { positions: allPos, faces: allFaces };

      currentMeshData = meshData;
      restPositions = meshData.positions.map(p => [p[0], p[1], p[2]]);
      deformedPositions = null;
      handles = [];
      handlesConfirmed = false;
      confirmBtn.textContent = '确定选择';
      confirmBtn.style.background = '';
      confirmBtn.style.borderColor = '';

      // 左场景
      clearGroup(modelScene, currentModelGroup);
      currentModelGroup = buildModelVisual(meshData.positions, meshData.faces);
      modelScene.add(currentModelGroup);

      // 右侧镜像显示
      updateDeformedVisual();

      // 正交相机适配：计算包围盒
      const box = new THREE.Box3();
      for (const p of meshData.positions) box.expandByPoint(new THREE.Vector3(p[0], p[1], p[2]));
      const size = box.getSize(new THREE.Vector3());
      const maxDim = Math.max(size.x, size.y, 0.5) * 0.65;
      modelCamera.left = -maxDim;
      modelCamera.right = maxDim;
      modelCamera.top = maxDim;
      modelCamera.bottom = -maxDim;
      modelCamera.updateProjectionMatrix();

      // 右侧相机适配（正交）
      resultCamera.left = -maxDim;
      resultCamera.right = maxDim;
      resultCamera.top = maxDim;
      resultCamera.bottom = -maxDim;
      resultCamera.updateProjectionMatrix();
      resultCamera.position.set(0, 0, 5);
      resultCamera.lookAt(0, 0, 0);

      updateHandleVisuals();
      modelInfo.textContent = '字母 ' + letter + ' | ' + meshData.positions.length + ' 顶点 | ' + meshData.faces.length + ' 面';
      resultInfo.textContent = '';
      setStatus('已加载字母 ' + letter, '#89f0b6');
    } catch (err) {
      console.error(err);
      setStatus('加载失败: ' + err.message, '#ff9d9d');
    }
  }

  // 填充字母选择器
  for (let i = 65; i <= 90; i++) {
    const letter = String.fromCharCode(i);
    const opt = document.createElement('option');
    opt.value = letter;
    opt.textContent = letter;
    letterSelect.appendChild(opt);
  }
  letterSelect.addEventListener('change', () => loadLetter(letterSelect.value));

  // ==================== 响应式 ====================
  function resize() {
    const leftRect = document.getElementById('left-panel').getBoundingClientRect();
    const rightRect = document.getElementById('right-panel').getBoundingClientRect();

    modelRenderer.setSize(leftRect.width, leftRect.height, false);
    const a = leftRect.width / Math.max(leftRect.height, 1);
    const curHalf = (modelCamera.right - modelCamera.left) / 2;
    modelCamera.left = -curHalf * a;
    modelCamera.right = curHalf * a;
    modelCamera.top = curHalf;
    modelCamera.bottom = -curHalf;
    modelCamera.updateProjectionMatrix();

    resultRenderer.setSize(rightRect.width, rightRect.height, false);
    const ra = rightRect.width / Math.max(rightRect.height, 1);
    const rCurHalf = (resultCamera.right - resultCamera.left) / 2;
    resultCamera.left = -rCurHalf * ra;
    resultCamera.right = rCurHalf * ra;
    resultCamera.top = rCurHalf;
    resultCamera.bottom = -rCurHalf;
    resultCamera.updateProjectionMatrix();
  }
  window.addEventListener('resize', resize);

  // ==================== 渲染循环 ====================
  function animate() {
    requestAnimationFrame(animate);
    modelRenderer.render(modelScene, modelCamera);
    resultRenderer.render(resultScene, resultCamera);
  }

  // ==================== 初始化 ====================
  resize();
  letterSelect.value = 'A';
  loadLetter('A');
  animate();
})();
</script>
</body>
</html>

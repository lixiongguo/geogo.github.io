{
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--completion-style=detailed",
    "--header-insertion=never",
    "--pch-storage=memory",
    "--fallback-style=Google",
    "--query-driver=C:/Program Files/**/cl.exe,C:/msys64/**/g++.exe,C:/mingw64/**/g++.exe"
  ],
  "clangd.fallbackFlags": [
    "-std=c++17",
    "-I${workspaceFolder}/cpp/conformal-parameterization",
    "-I${workspaceFolder}/cpp/conformal-parameterization/uv_unwrap_simple",
    "-I${workspaceFolder}/cpp/conformal-parameterization/Mosek",
    "-I${workspaceFolder}/cpp/deps/eigen-3.4.0",
    "-I${workspaceFolder}/cpp/deps/glm"
  ],
  "C_Cpp.intelliSenseEngine": "disabled"
}
